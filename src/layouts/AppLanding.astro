---
import Base from './Base.astro';
import FAQ from '../components/FAQ.astro';
import InternalLinks from '../components/InternalLinks.astro';
import AppCTA from '../components/AppCTA.astro';
import AppStoreAction from '../components/AppStoreAction.astro';
import { rel, abs, appStoreUrl, APP_STORE } from '../consts';
import { appStoreCampaignUrl, VIBERATER_ASC_TOKENS, TABLE_TALK_ASC_TOKENS, POWELL_PROWL_ASC_TOKENS, ECONBYTE_ASC_TOKENS, LAST_HUMAN_ASC_TOKENS } from '../lib/campaignLinks.mjs';
import { appBannerIdFor } from '../lib/appBanner';

export interface Props {
  app: any;
  related: { title: string; url: string; description: string }[];
}
const { app, related } = Astro.props;
const path = `/apps/${app.slug}/`;
const url = appStoreUrl(app.appStoreId);
const campaignToken =
  app.appStoreId === APP_STORE.vibeRater ? VIBERATER_ASC_TOKENS.appDetail :
  app.appStoreId === APP_STORE.tableTalk ? TABLE_TALK_ASC_TOKENS.appDetail :
  app.appStoreId === APP_STORE.monetaryPolicyIndependenceDay ? POWELL_PROWL_ASC_TOKENS.appDetail :
  app.appStoreId === APP_STORE.econByte ? ECONBYTE_ASC_TOKENS.appDetail :
  app.appStoreId === APP_STORE.lastHuman ? LAST_HUMAN_ASC_TOKENS.appDetail :
  undefined;
const taggedStoreUrl = campaignToken && app.appStoreId ? appStoreCampaignUrl(app.appStoreId, campaignToken) : '';
const iconWebp = app.icon.replace(/\.png$/i, '.webp');

// SoftwareApplication is Google's app-listing rich-result type (name, category,
// OS, free Offer). aggregateRating is intentionally omitted until we have real App
// Store reviews to source it from (faking it is a guidelines violation).
const appSchema: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': abs(`${path}#app`),
  name: app.name,
  description: app.description,
  url: abs(path),
  applicationCategory: app.applicationCategory,
  operatingSystem: app.operatingSystem,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isAccessibleForFree: true,
  author: { '@id': abs('/#organization') },
  publisher: { '@id': abs('/#organization') },
  mainEntityOfPage: { '@id': abs(path) },
  featureList: app.featureList,
};
if (url) appSchema.downloadUrl = url;
// Reuse the PNG already declared as this page's og:image.
if (app.ogImage) appSchema.image = abs(app.ogImage);

// FAQPage JSON-LD built from app.faq. Google won't render an FAQ rich result for a
// non-gov/health source, but this is still valid structured data and the Owner wants
// it for AEO / AI-citation value — answer engines (ChatGPT, Perplexity, Claude) parse
// FAQPage to lift clean Q&A pairs. Emitted alongside SoftwareApplication as a JSON-LD
// array (both objects in one @graph-style script), which the Rich Results Test accepts.
const faqSchema =
  app.faq && app.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: app.faq.map((f: { q: string; a: string }) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
const pageSchema = faqSchema ? [appSchema, faqSchema] : appSchema;
// Head-only overrides. Schema above still uses `description` and the visible
// answer still renders that same field.
const pageTitle = app.seoTitle || `${app.name} — ${app.tagline}`;
const pageDescription = app.seoDescription || app.description;
---
<Base title={pageTitle} description={pageDescription} path={path} ogImage={app.ogImage ?? app.icon} schema={pageSchema} breadcrumbLeaf={app.name} appBannerId={await appBannerIdFor(app.slug)}>
  <main class:list={['app-detail-page', `poster-${app.slug}`]}>
    <section class="app-detail-hero">
      <div class="wrap app-detail-hero-inner">
        <div class="app-detail-copy">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href={rel('/')}>Home</a><span class="sep">/</span>
            <a href={rel('/#apps')}>Apps</a><span class="sep">/</span>
            <span>{app.name}</span>
          </nav>
          <p class="poster-status">{app.status === 'live' ? 'Live on the App Store' : 'Coming to the App Store'}</p>
          <h1>{app.name}</h1>
          <p class="app-detail-headline">{app.posterHeadline}</p>
          <p class="app-answer">{app.description}</p>
          <AppStoreAction appName={app.name} href={taggedStoreUrl} />
        </div>
        <picture>
          <source srcset={rel(iconWebp)} type="image/webp" />
          <img class="app-detail-icon" src={rel(app.icon)} alt={`${app.name} app icon`} width="512" height="512" decoding="async" fetchpriority="high" />
        </picture>
      </div>
    </section>

    <div class="wrap app-detail-content">
      <nav class="crumbs">
        <a href={rel(`/privacy/${app.slug}/`)}>Privacy policy</a>
        <span class="sep">/</span>
        <a href={rel(`/support/${app.slug}/`)}>Support</a>
      </nav>

      <dl class="app-facts">
        <div><dt>Pricing</dt><dd>{app.pricingSummary}</dd></div>
        <div><dt>Account</dt><dd>{app.accountSummary}</dd></div>
        <div><dt>Offline</dt><dd>{app.offlineSummary}</dd></div>
        <div><dt>Privacy</dt><dd>{app.privacySummary}</dd></div>
      </dl>

      <article class="app-body"><slot /></article>

      <AppCTA
        appName={app.name}
        appStoreId={app.appStoreId}
        status={app.status}
        campaignToken={campaignToken}
      />

      <FAQ items={app.faq} />
      <InternalLinks pages={related} heading="More from Dudley Development" />
    </div>
  </main>
</Base>
