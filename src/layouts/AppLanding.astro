---
import Base from './Base.astro';
import FAQ from '../components/FAQ.astro';
import InternalLinks from '../components/InternalLinks.astro';
import AppCTA from '../components/AppCTA.astro';
import { STUDIO, ORIGIN, VIBERATER_SOCIALS, rel, abs, appStoreUrl } from '../consts';

export interface Props {
  app: any;
  related: { title: string; url: string; description: string }[];
}
const { app, related } = Astro.props;
const path = `/apps/${app.slug}/`;
const url = appStoreUrl(app.appStoreId);
const appImage = abs(app.ogImage ?? app.icon);
const privacyRoutes = new Set(['monetary-policy-independence-day', 'vibe-rater', 'table-talk']);
const hasPrivacyPolicy = privacyRoutes.has(app.slug);
// App-level social accounts (currently only VibeRater has its own handles).
const socials = app.slug === 'vibe-rater' ? VIBERATER_SOCIALS : [];
// "VibeRater: Aura" → "VibeRater" for the follow heading.
const followName = app.name.split(':')[0].trim();

// SoftwareApplication is Google's app-listing rich-result type (name, category,
// OS, free Offer). aggregateRating is intentionally omitted until we have real App
// Store reviews to source it from (faking it is a guidelines violation).
const appSchema: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': abs(path) + '#softwareapplication',
  name: app.name,
  alternateName: app.slug === 'vibe-rater' ? 'VibeRater' : undefined,
  description: app.description,
  url: abs(path),
  mainEntityOfPage: { '@type': 'WebPage', '@id': abs(path) + '#webpage' },
  image: appImage,
  thumbnailUrl: abs(app.icon),
  identifier: app.bundleId ? { '@type': 'PropertyValue', propertyID: 'iOS bundle identifier', value: app.bundleId } : undefined,
  applicationCategory: app.applicationCategory,
  operatingSystem: app.operatingSystem,
  keywords: [app.primaryKeyword, app.category, ...(app.featureList ?? [])].filter(Boolean).join(', '),
  isAccessibleForFree: app.status === 'live' ? true : undefined,
  datePublished: app.dateAdded ? app.dateAdded.toISOString().slice(0, 10) : undefined,
  dateModified: app.lastUpdated ? app.lastUpdated.toISOString().slice(0, 10) : undefined,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', '@id': abs('/#organization'), name: STUDIO, url: ORIGIN },
  publisher: { '@type': 'Organization', '@id': abs('/#organization'), name: STUDIO, url: ORIGIN },
  featureList: app.featureList,
  sameAs: socials.length > 0 ? socials.map((s) => s.url) : undefined,
  ...(hasPrivacyPolicy ? { privacyPolicy: abs(`/privacy/${app.slug}`) } : {}),
};
if (url) {
  appSchema.downloadUrl = url;
  appSchema.installUrl = url;
  appSchema.potentialAction = {
    '@type': 'DownloadAction',
    target: url,
  };
}
Object.keys(appSchema).forEach((key) => appSchema[key] === undefined && delete appSchema[key]);

// FAQPage JSON-LD built from app.faq. Google won't render an FAQ rich result for a
// non-gov/health source, but this is still valid structured data and the Owner wants
// it for AEO / AI-citation value — answer engines (ChatGPT, Perplexity, Claude) parse
// FAQPage to lift clean Q&A pairs. Emitted alongside SoftwareApplication as a JSON-LD
// array (both objects in one @graph-style script), which the Rich Results Test accepts.
const faqSchema =
  app.faq && app.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        '@id': abs(path) + '#faq',
        url: abs(path),
        name: `${app.name} FAQ`,
        description: app.description,
        isPartOf: { '@id': abs('/#website') },
        publisher: { '@id': abs('/#organization') },
        about: { '@id': abs(path) + '#softwareapplication' },
        mainEntity: app.faq.map((f: { q: string; a: string }) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
const pageSchema = faqSchema ? [appSchema, faqSchema] : appSchema;
---
<Base title={`${app.name} — ${app.tagline}`} description={app.description} path={path} ogImage={app.ogImage ?? app.icon} schema={pageSchema} breadcrumbLeaf={app.name}>
  <main class="page">
    <div class="wrap" style="max-width:760px;">
      <nav class="crumbs">
        <a href={rel('/')}>Home</a><span class="sep">/</span>
        <a href={rel('/#apps')}>Apps</a><span class="sep">/</span>
        <span>{app.name}</span>
      </nav>

      <div class="lede-hero">
        <img class="icon" src={rel(app.icon)} alt={`${app.name} app icon`} />
        <div>
          <h1>{app.name}</h1>
          <p class="updated">{app.tagline}{app.status === 'live' ? ' · Live on the App Store' : ' · Coming soon'}</p>
        </div>
      </div>

      <slot />

      <AppCTA appName={app.name} appStoreId={app.appStoreId} status={app.status} />

      {socials.length > 0 && (
        <div class="cta-block">
          <h3>Follow {followName}</h3>
          <p>New drops, archetype reveals, and vibe checks — follow {followName} for the latest.</p>
          {socials.map((s) => (
            <a class="btn" href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label} style="margin-right:10px;">
              {s.name} {s.handle}
            </a>
          ))}
        </div>
      )}

      <FAQ items={app.faq} />
      <InternalLinks pages={related} heading="More from Dudley Development" />
    </div>
  </main>
</Base>
