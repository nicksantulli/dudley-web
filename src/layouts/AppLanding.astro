---
import Base from './Base.astro';
import FAQ from '../components/FAQ.astro';
import InternalLinks from '../components/InternalLinks.astro';
import AppCTA from '../components/AppCTA.astro';
import { STUDIO, ORIGIN, rel, abs, appStoreUrl } from '../consts';

export interface Props {
  app: any;
  related: { title: string; url: string; description: string }[];
}
const { app, related } = Astro.props;
const path = `/apps/${app.slug}/`;
const url = appStoreUrl(app.appStoreId);
const isVibeRater = app.slug === 'vibe-rater';
const releaseScreens = isVibeRater ? [
  { src: '/assets/viberater-21-vibes.jpg', alt: 'VibeRater Full Screen Vibes feed with rating and social controls', title: 'Choose your feed', caption: 'Move between Full Screen and Timeline without losing your place.' },
  { src: '/assets/viberater-21-radar.jpg', alt: 'VibeRater Radar map showing nearby places, people, filters, and events', title: 'Take the vibe outside', caption: 'Explore nearby places and events, then turn discovery into a plan.' },
  { src: '/assets/viberater-21-repli.jpg', alt: 'VibeRater Repli room with avatar, furniture, VibeShop, Play, Style, and Edit controls', title: 'Build your Repli', caption: 'Style a companion, decorate rooms, visit friends, shop, and play.' },
  { src: '/assets/viberater-21-rodeo.jpg', alt: 'VibeRodeo studio with project templates, photo editor, quick post, and drafts', title: 'Create a VibeRodeo', caption: 'Cut clips or use the dedicated still-photo editor.' },
  { src: '/assets/viberater-21-rate.jpg', alt: 'VibeRater result screen with a score, aura, archetype, and sharing controls', title: 'Rate the moment', caption: 'Keep it private, post it, challenge, or share.' },
] : [];

// SoftwareApplication is Google's app-listing rich-result type (name, category,
// OS, free Offer). aggregateRating is intentionally omitted until we have real App
// Store reviews to source it from (faking it is a guidelines violation).
const appSchema: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  description: app.description,
  url: abs(path),
  applicationCategory: app.applicationCategory,
  operatingSystem: app.operatingSystem,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: STUDIO, url: ORIGIN },
  featureList: app.featureList,
};
if (url) appSchema.downloadUrl = url;

// FAQPage JSON-LD built from app.faq. Google won't render an FAQ rich result for a
// non-gov/health source, but this is still valid structured data and the Owner wants
// it for AEO / AI-citation value — answer engines (ChatGPT, Perplexity, Claude) parse
// FAQPage to lift clean Q&A pairs. Emitted alongside SoftwareApplication as a JSON-LD
// array (both objects in one @graph-style script), which the Rich Results Test accepts.
const faqSchema =
  app.faq && app.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: app.faq.map((f: { q: string; a: string }) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;
const pageSchema = faqSchema ? [appSchema, faqSchema] : appSchema;
---
<Base title={`${app.name} — ${app.tagline}`} description={app.description} path={path} ogImage={app.ogImage ?? app.icon} schema={pageSchema} breadcrumbLeaf={app.name}>
  <main class="page">
    <div class="wrap" style="max-width:760px;">
      <nav class="crumbs">
        <a href={rel('/')}>Home</a><span class="sep">/</span>
        <a href={rel('/#work')}>Apps</a><span class="sep">/</span>
        <span>{app.name}</span>
      </nav>

      <div class="app-release-hero">
        <img src={rel(app.icon)} alt={`${app.name} app icon`} />
        <div>
          <p class="release-note">{app.status === 'live' ? `${app.version ? `Version ${app.version} · ` : ''}Live` : 'Coming soon'}</p>
          <h1>{app.name}</h1>
          <p>{app.tagline}</p>
          <div class="hero-actions">
            {url && <a class="btn primary" href={url} rel="noopener">Download on the App Store</a>}
            {app.status === 'live' && <a class="btn" href={rel(`/privacy/${app.slug}`)}>Privacy</a>}
            {app.support?.length > 0 && <a class="btn" href={rel(`/support/${app.slug}`)}>Support</a>}
          </div>
        </div>
      </div>

      {releaseScreens.length > 0 && (
        <section class="app-screenshots app-screenshots-featured" aria-labelledby="release-screens-title">
          <header>
            <p class="release-note">Current App Store screens</p>
            <h2 id="release-screens-title">See what shipped in {app.version ?? 'the latest release'}.</h2>
            <p>Swipe through the live social, creation, discovery, and rating surfaces.</p>
          </header>
          <div class="app-shot-rail" tabindex="0" aria-label={`${app.name} product screenshots. Swipe or scroll horizontally.`}>
            {releaseScreens.map((screen) => (
              <figure>
                <img src={rel(screen.src)} alt={screen.alt} width="600" height="1304" loading="lazy" />
                <figcaption><strong>{screen.title}</strong>{screen.caption}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      <slot />

      <AppCTA appName={app.name} appStoreId={app.appStoreId} status={app.status} />

      <FAQ items={app.faq} />
      <InternalLinks pages={related} heading="More from Dudley Development" />
    </div>
  </main>
</Base>
