---
import Base from './Base.astro';
import FAQ from '../components/FAQ.astro';
import InternalLinks from '../components/InternalLinks.astro';
import AppCTA from '../components/AppCTA.astro';
import { STUDIO, rel, abs, APP_STORE } from '../consts';
import { postTags, formatDate, getPublishedPosts } from '../lib/blog';
import { eligibleTopicHubs, topicsForPost, unmappedLabelsForPost } from '../lib/topics';
import { blogCampaignToken, powellProwlBlogCampaignToken, econbyteBlogCampaignToken, tableTalkBlogCampaignToken } from '../lib/campaignLinks.mjs';
import { appBannerIdFor } from '../lib/appBanner';

export interface Props {
  post: any; // blog entry data + slug
  related: { title: string; url: string; description: string }[];
}
const { post, related } = Astro.props;
const path = `/blog/${post.slug}/`;
const published = post.publishDate as Date;
const updated = (post.updatedDate ?? post.publishDate) as Date;

// Which app to surface in the CTA — first related app, defaulting to VibeRater Social.
const APP_META: Record<string, { name: string; id: string }> = {
  'monetary-policy-independence-day': { name: 'Powell Prowl: Rate Chase', id: APP_STORE.monetaryPolicyIndependenceDay },
  'vibe-rater': { name: 'VibeRater Social', id: APP_STORE.vibeRater },
  'table-talk': { name: 'Table Talk: Conversation Cards', id: '6780714565' },
  'econbyte': { name: 'EconByte', id: APP_STORE.econByte },
};
const ctaKey = post.relatedApps?.find((a: string) => APP_META[a]) ?? 'vibe-rater';
const cta = APP_META[ctaKey];

const ogImage = post.ogImage ?? '/assets/og-home.png';
const tags = postTags({ data: post } as any);
const postEntry = { data: post } as any;
const eligibleTopics = new Set(eligibleTopicHubs(await getPublishedPosts()).map((hub) => hub.slug));
const topicLinks = topicsForPost(postEntry, eligibleTopics);
const unmappedLabels = unmappedLabelsForPost(postEntry);

const articleSchema = {
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  url: abs(path),
  datePublished: published.toISOString(),
  dateModified: updated.toISOString(),
  author: { '@type': 'Person', name: post.author },
  ...(post.reviewedBy ? { reviewedBy: { '@type': 'Person', name: post.reviewedBy } } : {}),
  publisher: { '@id': abs('/#organization') },
  mainEntityOfPage: { '@id': abs(path) },
  image: abs(ogImage),
  keywords: tags.join(', '),
  ...(post.primaryKeyword ? { about: { '@type': 'Thing', name: post.primaryKeyword } } : {}),
};
// BreadcrumbList is emitted site-wide by Base. FAQ schema is included only when
// the same questions and answers are rendered visibly below the article.
const faqSchema = post.faq?.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: post.faq.map((item: { q: string; a: string }) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
} : null;
const schema = faqSchema
  ? [{ '@context': 'https://schema.org', ...articleSchema }, faqSchema]
  : { '@context': 'https://schema.org', ...articleSchema };
---
<Base
  title={post.title}
  description={post.description}
  path={path}
  ogImage={ogImage}
  schema={schema}
  breadcrumbLeaf={post.title}
  appBannerId={await appBannerIdFor(ctaKey)}
>
  <main class="page">
    <div class="wrap" style="max-width:720px;">
      <nav class="crumbs">
        <a href={rel('/')}>Home</a><span class="sep">/</span>
        <a href={rel('/blog/')}>Blog</a><span class="sep">/</span>
        <span>{post.title}</span>
      </nav>

      <article class="post">
        <header class="post-head">
          <h1>{post.title}</h1>
          <p class="post-meta">
            <span class="byline">Written by {post.author ?? STUDIO}</span>
            <span class="sep">·</span><span>Published </span>
            <time datetime={published.toISOString().slice(0, 10)}>{formatDate(published)}</time>
            {updated.getTime() !== published.getTime() && (
              <><span class="sep">·</span><span>Updated </span><time datetime={updated.toISOString().slice(0, 10)}>{formatDate(updated)}</time></>
            )}
            {post.reviewedBy && <><span class="sep">·</span><span>Reviewed by {post.reviewedBy}</span></>}
          </p>
          <p class="answer-summary">{post.answerSummary ?? post.description}</p>
          <nav class="post-tags" aria-label="Topics and labels">
            {topicLinks.map((topic) => (
              <a class="tag" href={rel(`/blog/topics/${topic.slug}/`)}>{topic.title}</a>
            ))}
            {unmappedLabels.map((label) => <span class="tag tag-label">{label}</span>)}
          </nav>
        </header>

        <div class="post-body">
          <slot />
        </div>
      </article>

      <AppCTA
        appName={cta.name}
        appStoreId={cta.id}
        status={cta.id ? 'live' : 'coming_soon'}
        campaignToken={
          ctaKey === 'vibe-rater'                       ? blogCampaignToken(post.slug) :
          ctaKey === 'monetary-policy-independence-day'  ? powellProwlBlogCampaignToken(post.slug) :
          ctaKey === 'econbyte'                          ? econbyteBlogCampaignToken(post.slug) :
          ctaKey === 'table-talk'                        ? tableTalkBlogCampaignToken(post.slug) :
          undefined
        }
        blurb={`Liked this? ${cta.name} ${cta.id ? 'is free on the App Store.' : 'is launching on the App Store soon.'}`}
      />
      <p class="app-promotion-disclosure">Dudley Development makes the app mentioned above. The editorial answer is written to stand on its own.</p>

      <FAQ items={post.faq} />
      <InternalLinks pages={related} heading="Keep reading" />
    </div>
  </main>
</Base>
