---
import { formatDate } from '../lib/blog';
import { rel } from '../consts';
interface Props { title: string; description: string; href: string; date: Date; topic?: string; headingLevel?: 2 | 3; }
const { title, description, href, date, topic, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---
<article class="answer-card">
  <a href={rel(href)}>
    <div class="answer-meta">
      {topic && <span>{topic}</span>}
      <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
    </div>
    <Heading>{title}</Heading>
    <p>{description}</p>
    <span class="answer-link">Read the answer</span>
  </a>
</article>
