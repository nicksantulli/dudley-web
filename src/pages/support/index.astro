---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { rel, SUPPORT_EMAIL } from '../../consts';
import { isReleasedApp } from '../../lib/liveApps.mjs';

// Data-driven: any app with a non-empty `support` array gets a card here and its
// own /support/<slug> page. Adding support for a new app = add a `support:` block
// to its src/content/apps/<slug>.mdx — no changes to this page required.
const apps = (await getCollection('apps'))
  .filter((a) => isReleasedApp(a) && a.data.support && a.data.support.length > 0)
  .sort((a, b) => a.data.order - b.data.order);

const description = 'Support for Dudley Development apps. Pick your app for FAQs and contact options.';
---
<Base title="Support" description={description} path="/support/">
  <main class="page">
    <div class="wrap" style="max-width:720px;">
      <a class="back" href={rel('/')}>← Home</a>
      <h1>Support</h1>
      <p class="updated">Choose your app for its FAQs.</p>

      <p>
        For a bug report, email <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> with the app name, the
        screen, your device model and iOS version (Settings → General → About), what happened, and a screenshot or
        screen recording if you have one.
      </p>

      <ul class="policy-list">
        {apps.map((app) => (
          <li>
            <a class="row" href={rel(`/support/${app.id}/`)}>
              <img src={rel(app.data.icon)} alt={`${app.data.name} app icon`} width="44" height="44" loading="lazy" />
              <span class="meta"><b>{app.data.name}</b><span>Help &amp; FAQs</span></span>
              <span class="chev">→</span>
            </a>
          </li>
        ))}
      </ul>

      <h2>Still need help?</h2>
      <p>
        Email <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> or use the{' '}
        <a href={rel('/contact/')}>contact form</a>. Both reach the same inbox.
      </p>
    </div>
  </main>
</Base>
