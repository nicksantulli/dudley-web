---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { rel, SUPPORT_EMAIL, CONTACT_EMAIL, LEGAL_NAME } from '../consts';
const description = 'Dudley Development builds and publishes iPhone games, conversation tools, social apps, and plain-English learning products.';

// "The apps" is data-driven off the same content collection that powers the app cards,
// per-app pages, and launch-status mechanism (DUD-182) — so the list, ordering, and
// live/coming-soon status here can never drift from the rest of the site again.
// Client work (developedFor set, e.g. HomeLight) is excluded — those are the studio's
// own apps only. Flip an app's `status` in its .mdx and every surface updates together.
const ownApps = (await getCollection('apps'))
  .filter((a) => !a.data.developedFor)
  .sort((x, y) => x.data.order - y.data.order);
const statusLabel = (s: string) =>
  s === 'live' ? 'Live on the App Store' : s === 'in_development' ? 'In development' : 'Coming soon';
---
<Base title="About" description={description} path="/about">
  <main class="page">
    <div class="wrap" style="max-width:760px;">
      <nav class="crumbs">
        <a href={rel('/')}>Home</a><span class="sep">/</span>
        <span>About</span>
      </nav>

      <h1>About Dudley Development</h1>
      <p class="updated">{LEGAL_NAME} · Founded by Nicholas Santulli · United States</p>

      <p class="tldr">
        Dudley Development builds iPhone products you can understand before you download: games,
        conversation starters, social tools, and short lessons with clear prices and privacy boundaries.
      </p>

      <h2>How the apps work</h2>
      <ul>
        <li><strong>Download price.</strong> Every Dudley app is free on the App Store. Optional purchases, when offered, are described on the app page.</li>
        <li><strong>Accounts.</strong> Most apps work without one. VibeRater uses profiles for its social features and provides account-deletion controls.</li>
        <li><strong>Privacy.</strong> Each app page states what works offline, what stays on the device, and where to read the full policy.</li>
        <li><strong>Ads.</strong> Ad-supported apps request non-personalized ads and do not request Apple’s cross-app tracking permission.</li>
      </ul>

      <h2>The apps</h2>
      <ul class="about-apps">
        {ownApps.map((a) => (
          <li>
            <span class="about-app-name">
              {a.data.landingPage !== false
                ? <a href={rel(`/apps/${a.slug}/`)}>{a.data.name}</a>
                : a.data.name}
            </span>
            <span class="about-app-tagline">{a.data.tagline}</span>
            <span class={`badge ${a.data.status === 'live' ? 'live' : 'soon'}`}>
              <span class="dot"></span> {statusLabel(a.data.status)}
            </span>
          </li>
        ))}
      </ul>
      <p>See them all — plus our client work — on the <a href={rel('/#apps')}>home page</a>.</p>

      <h2>Get in touch</h2>
      <p>
        Got a bug or need help? Use the <a href={rel('/contact/')}>contact form</a>, head to
        <a href={rel('/support/')}>Support</a>, or email
        <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>. Just want to say hi or talk shop? Reach us at
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>

      <div class="cta-block">
        <h2>Want to work with us?</h2>
        <p>We take on a small amount of client work each year — iOS apps designed, built, and shipped end to end.</p>
        <div class="actions">
          <a class="btn primary" href={rel('/contact/?topic=build-an-app')}>Start a conversation</a>
        </div>
      </div>
    </div>
  </main>
</Base>

<style>
  .about-apps { list-style: none; padding: 0; margin: 0 0 1rem; }
  .about-apps li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    padding: 0.75rem 0;
    border-bottom: 2px solid var(--ink);
  }
  .about-apps li:last-child { border-bottom: 0; }
  .about-app-name { font-weight: 700; font-size: 1.0625rem; color: var(--ink); }
  .about-app-tagline { color: var(--ink-muted); font-size: 0.9375rem; flex: 1 1 12rem; min-width: 0; }
</style>
