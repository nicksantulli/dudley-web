---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { rel, SUPPORT_EMAIL, CONTACT_EMAIL, LEGAL_NAME } from '../consts';
const description = 'Dudley Development is a small independent studio building polished, playful iPhone apps.';

// "The apps" is data-driven off the same content collection that powers the app cards,
// per-app pages, and launch-status mechanism (DUD-182) — so the list, ordering, and
// live/coming-soon status here can never drift from the rest of the site again.
// Client work (developedFor set, e.g. HomeLight) is excluded — those are the studio's
// own apps only. Flip an app's `status` in its .mdx and every surface updates together.
const ownApps = (await getCollection('apps'))
  .filter((a) => !a.data.developedFor)
  .sort((x, y) => x.data.order - y.data.order);
const statusLabel = (s: string) =>
  s === 'live' ? 'Live on the App Store' : s === 'in_development' ? 'In development' : 'Coming soon';
---
<Base title="About" description={description} path="/about">
  <main class="page">
    <div class="wrap" style="max-width:760px;">
      <nav class="crumbs">
        <a href={rel('/')}>Home</a><span class="sep">/</span>
        <span>About</span>
      </nav>

      <h1>About Dudley Development</h1>
      <p class="updated">Independent iOS studio · {LEGAL_NAME} · United States</p>

      <p class="tldr">
        Dudley Development is a small independent studio making iPhone apps — the kind that are quick
        to pick up, do one thing with a bit of personality, and don't ask anything of you to start playing.
      </p>

      <h2>What we believe</h2>
      <ul>
        <li><strong>Free to start.</strong> Every app is free to download and play. No paywalls in the way of the fun.</li>
        <li><strong>Low-friction by default.</strong> You can start using our apps without a paywall. If a social feature needs a profile, we explain what it stores and give you deletion controls.</li>
        <li><strong>Privacy by feature.</strong> Each privacy policy says what stays on-device, what reaches a service, what is stored, and why.</li>
        <li><strong>Honest about ads.</strong> Our free apps are ad-supported through Google AdMob and disclosed plainly. The ads are requested as non-personalized, and our apps do not request cross-app tracking permission.</li>
        <li><strong>Polish is the point.</strong> Tight controls, real haptics, and a sense of humor — details that make an app feel made, not generated.</li>
      </ul>

      <h2>The apps</h2>
      <ul class="about-apps">
        {ownApps.map((a) => (
          <li>
            <span class="about-app-name">
              {a.data.landingPage !== false
                ? <a href={rel(`/apps/${a.slug}/`)}>{a.data.name}</a>
                : a.data.name}
            </span>
            <span class="about-app-tagline">{a.data.tagline}</span>
            <span class={`badge ${a.data.status === 'live' ? 'live' : 'soon'}`}>
              <span class="dot"></span> {statusLabel(a.data.status)}
            </span>
          </li>
        ))}
      </ul>
      <p>See them all — plus our client work — on the <a href={rel('/#apps')}>home page</a>.</p>

      <h2>Get in touch</h2>
      <p>
        Got a bug or need help? Use the <a href={rel('/contact/')}>contact form</a>, head to
        <a href={rel('/support')}>Support</a>, or email
        <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>. Just want to say hi or talk shop? Reach us at
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>

      <div class="cta-block">
        <h2>Want to work with us?</h2>
        <p>We take on a small amount of client work each year — iOS apps designed, built, and shipped end to end.</p>
        <div class="actions">
          <a class="btn primary" href={rel('/contact/')}>Start a conversation</a>
        </div>
      </div>
    </div>
  </main>
</Base>

<style>
  .about-apps { list-style: none; padding: 0; margin: 0 0 1rem; }
  .about-apps li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }
  .about-apps li:last-child { border-bottom: 0; }
  .about-app-name { font-weight: 700; font-size: 1.0625rem; color: var(--ink); }
  .about-app-tagline { color: var(--ink-muted); font-size: 0.9375rem; flex: 1 1 12rem; min-width: 0; }
</style>
