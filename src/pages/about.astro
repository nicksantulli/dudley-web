---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { rel, SUPPORT_EMAIL, CONTACT_EMAIL, LEGAL_NAME } from '../consts';
import { liveApps } from '../lib/liveApps.mjs';
const description = 'Dudley Development builds and publishes iPhone games, conversation cards, plain-language learning apps, and everyday utilities.';

// "The apps" is data-driven off the same content collection that powers the app cards
// and per-app pages, so it lists exactly the released apps the home page shows.
// Client work (developedFor set, e.g. HomeLight) is excluded.
const allApps = await getCollection('apps');
const ownApps = liveApps(allApps).filter((a) => !a.data.developedFor);
---
<Base title="About" description={description} path="/about">
  <main class="page">
    <div class="wrap" style="max-width:760px;">
      <nav class="crumbs">
        <a href={rel('/')}>Home</a><span class="sep">/</span>
        <span>About</span>
      </nav>

      <h1>About Dudley Development</h1>
      <p class="updated">{LEGAL_NAME} · Founded by <a href={rel('/about/nick-santulli/')}>Nick Santulli</a> · United States</p>

      <p class="tldr">
        Dudley Development builds iPhone apps you can understand before you download: games,
        conversation cards, short lessons, and everyday utilities with clear prices and privacy boundaries.
      </p>

      <h2>How the apps work</h2>
      <ul>
        <li><strong>Download price.</strong> Every app Dudley has published on the App Store is free to download. Optional purchases, when an app offers them, are described on its app page.</li>
        <li><strong>Accounts.</strong> Most Dudley apps work without one. When an app needs an account, its app page and privacy policy say so.</li>
        <li><strong>Privacy.</strong> Each app page states what works offline, what stays on the device, and where to read the full policy.</li>
        <li><strong>Ads.</strong> Some apps show ads through Google AdMob. Each app’s <a href={rel('/privacy/')}>privacy policy</a> says whether its ads can be personalized and whether it asks for Apple’s tracking permission.</li>
      </ul>

      <h2>The apps</h2>
      <ul class="about-apps">
        {ownApps.map((a) => (
          <li>
            <span class="about-app-name">
              {a.data.landingPage !== false
                ? <a href={rel(`/apps/${a.id}/`)}>{a.data.name}</a>
                : a.data.name}
            </span>
            <span class="about-app-tagline">{a.data.tagline}</span>
            <span class="badge live">
              <span class="dot"></span> Live on the App Store
            </span>
          </li>
        ))}
      </ul>
      <p>See them all on the <a href={rel('/#apps')}>home page</a>.</p>

      <h2>Get in touch</h2>
      <p>
        For general questions, partnerships, or press, email
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>. For a bug or help with an app, see
        <a href={rel('/support/')}>Support</a> or email <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.
        You can also use the <a href={rel('/contact/')}>contact form</a>.
      </p>

      <div class="cta-block">
        <h2>Client work</h2>
        <p>We also design, build, and release iPhone apps for other companies, branded as theirs and published on the App Store. Client apps are not part of the Dudley catalog above.</p>
        <div class="actions">
          <a class="btn primary" href={rel('/contact/?topic=build-an-app')}>Start a conversation</a>
        </div>
      </div>
    </div>
  </main>
</Base>

<style>
  .about-apps { list-style: none; padding: 0; margin: 0 0 1rem; }
  .about-apps li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    padding: 0.75rem 0;
    border-bottom: 2px solid var(--ink);
  }
  .about-apps li:last-child { border-bottom: 0; }
  .about-app-name { font-weight: 700; font-size: 1.0625rem; color: var(--ink); }
  .about-app-tagline { color: var(--ink-muted); font-size: 0.9375rem; flex: 1 1 12rem; min-width: 0; }
</style>
