---
import Base from '../../../layouts/Base.astro';
import { rel } from '../../../consts';
import { getPublishedPosts } from '../../../lib/blog';
import { eligibleTopicHubs } from '../../../lib/topics';

const hubs = eligibleTopicHubs(await getPublishedPosts());
const path = '/blog/topics/';
const title = 'Dudley Blog Topics';
const description = 'Durable guides to iPhone privacy, AI media, internet culture, economics, the App Store, and Dudley apps.';
---
<Base title={title} description={description} path={path} breadcrumbLeaf="Topics">
  <main class="page editorial-page">
    <div class="wrap topic-index">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={rel('/')}>Home</a><span>/</span><a href={rel('/blog/')}>Blog</a><span>/</span><span>Topics</span></nav>
      <header class="topic-intro"><p class="section-label">Answer library</p><h1>Useful topics, not a tag cloud.</h1><p>{description}</p></header>
      <ul class="topic-list">
        {hubs.map((hub) => (
          <li><a href={rel(`/blog/topics/${hub.slug}/`)}><span><strong>{hub.title}</strong>{hub.description}</span><span class="count">{hub.posts.length} answers →</span></a></li>
        ))}
      </ul>
    </div>
  </main>
</Base>
