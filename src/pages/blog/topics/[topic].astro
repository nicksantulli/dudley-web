---
import Base from '../../../layouts/Base.astro';
import AnswerCard from '../../../components/AnswerCard.astro';
import { abs, rel } from '../../../consts';
import { getPublishedPosts } from '../../../lib/blog';
import { eligibleTopicHubs } from '../../../lib/topics';

export async function getStaticPaths() {
  const hubs = eligibleTopicHubs(await getPublishedPosts());
  return hubs.map((hub) => ({ params: { topic: hub.slug }, props: { hub } }));
}

const { hub } = Astro.props;
const path = `/blog/topics/${hub.slug}/`;
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: hub.title, description: hub.description,
  url: abs(path), isPartOf: { '@type': 'Blog', name: 'The Dudley Blog', url: abs('/blog/') },
  mainEntity: { '@type': 'ItemList', numberOfItems: hub.posts.length, itemListElement: hub.posts.map((post: any, index: number) => ({ '@type': 'ListItem', position: index + 1, url: abs(`/blog/${post.slug}/`), name: post.data.title })) },
};
---
<Base title={`${hub.title} — The Dudley Blog`} description={hub.description} path={path} schema={schema} breadcrumbLeaf={hub.title}>
  <main class="page editorial-page">
    <div class="wrap topic-page">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={rel('/')}>Home</a><span>/</span><a href={rel('/blog/')}>Blog</a><span>/</span><a href={rel('/blog/topics/')}>Topics</a><span>/</span><span>{hub.title}</span></nav>
      <header class="topic-intro"><p class="section-label">Dudley Blog topic · {hub.posts.length} answers</p><h1>{hub.title}</h1><p>{hub.description}</p></header>
      <div class="answer-grid">
        {hub.posts.map((post: any) => <AnswerCard title={post.data.title} description={post.data.answerSummary ?? post.data.description} href={`/blog/${post.slug}/`} date={post.data.publishDate} topic={hub.title} />)}
      </div>
    </div>
  </main>
</Base>
