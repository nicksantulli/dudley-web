---
import Base from '../../layouts/Base.astro';
import AnswerCard from '../../components/AnswerCard.astro';
import { STUDIO, ORIGIN, rel, abs } from '../../consts';
import { getPublishedPosts, POSTS_PER_PAGE } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const pageNum = index + 2;
    return { params: { page: String(pageNum) }, props: { pageNum, totalPages, posts: posts.slice((pageNum - 1) * POSTS_PER_PAGE, pageNum * POSTS_PER_PAGE) } };
  });
}

const { pageNum, totalPages, posts } = Astro.props;
const path = `/blog/${pageNum}/`;
const title = `The Dudley Blog — Page ${pageNum}`;
const description = `Plain-English answers from the Dudley Blog, page ${pageNum} of ${totalPages}.`;
const schema = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, description, url: abs(path), isPartOf: { '@type': 'Blog', name: 'The Dudley Blog', url: abs('/blog/') }, publisher: { '@type': 'Organization', name: STUDIO, url: ORIGIN } };
---
<Base title={title} description={description} path={path} schema={schema} breadcrumbLeaf={`Page ${pageNum}`}>
  <main class="page editorial-page">
    <div class="wrap blog-wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href={rel('/')}>Home</a><span>/</span><a href={rel('/blog/')}>Blog</a><span>/</span><span>Page {pageNum}</span></nav>
      <header class="blog-hero"><p class="section-label">Archive</p><h1>More straight answers.</h1><p>Page {pageNum} of {totalPages}.</p></header>
      <div class="answer-grid">
        {posts.map((post) => <AnswerCard title={post.data.title} description={post.data.answerSummary ?? post.data.description} href={`/blog/${post.id}/`} date={post.data.publishDate} topic={post.data.category} />)}
      </div>
      <nav class="pagination" aria-label="Blog pages">
        <a class="btn" href={pageNum <= 2 ? rel('/blog/') : rel(`/blog/${pageNum - 1}/`)}>← Previous</a>
        <span aria-current="page">Page {pageNum} of {totalPages}</span>
        {pageNum < totalPages ? <a class="btn" href={rel(`/blog/${pageNum + 1}/`)}>Next →</a> : <span />}
      </nav>
    </div>
  </main>
</Base>
