---
import Base from '../../layouts/Base.astro';
import { STUDIO, ORIGIN, rel, abs } from '../../consts';
import { getPublishedPosts, getAllTags, postTags, tagSlug, tagLabel, formatDate } from '../../lib/blog';

const posts = await getPublishedPosts();
const tags = await getAllTags();
const featuredTags = tags.filter((tag) => tag.count > 1).slice(0, 6);
const remainingTags = tags.filter((tag) => !featuredTags.some((featured) => featured.slug === tag.slug));
const path = '/blog/';
const title = 'The Dudley Blog';
const description =
  'Culture, archetypes, and honest app roundups from Dudley Development — the studio behind Vibe Rater and Monetary Policy: Independence Day. Vibe science, taken exactly as seriously as it deserves.';

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: title,
  description,
  url: abs(path),
  publisher: {
    '@type': 'Organization',
    name: STUDIO,
    url: ORIGIN,
    logo: { '@type': 'ImageObject', url: abs('/assets/dudley-mark.svg') },
  },
  blogPost: posts.slice(0, 25).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    description: p.data.description,
    url: abs(`/blog/${p.slug}/`),
    datePublished: p.data.publishDate.toISOString().slice(0, 10),
    author: { '@type': 'Organization', name: p.data.author },
  })),
};
---
<Base title={title} description={description} path={path} schema={blogSchema}>
  <main class="page">
    <div class="wrap blog-index-shell">
      <header class="blog-hero">
        <span class="blog-kicker">Ideas, answers, and launch notes</span>
        <h1>The Dudley Blog</h1>
        <p>{description}</p>
      </header>

      <div class="blog-toolbar">
        {featuredTags.length > 0 && (
          <nav class="featured-topics" aria-label="Popular blog topics">
            <span class="topic-label">Popular topics</span>
            {featuredTags.map((t) => (
              <a class="tag" href={rel(`/blog/tags/${t.slug}/`)}>{tagLabel(t.tag)} <span>{t.count}</span></a>
            ))}
          </nav>
        )}
        <div class="blog-toolbar-actions">
          {remainingTags.length > 0 && (
            <details class="all-topics">
              <summary>All topics <span>{tags.length}</span></summary>
              <nav class="tag-cloud" aria-label="All blog topics">
                {remainingTags.map((t) => (
                  <a class="tag" href={rel(`/blog/tags/${t.slug}/`)}>{tagLabel(t.tag)} <span>{t.count}</span></a>
                ))}
              </nav>
            </details>
          )}
          <a class="rss-link" href={rel('/blog/rss.xml')}>RSS</a>
        </div>
      </div>

      {posts.length === 0 ? (
        <p>No posts yet — check back soon.</p>
      ) : (
        <section class="latest-posts" aria-labelledby="latest-posts-title">
          <div class="latest-posts-heading">
            <h2 id="latest-posts-title">Latest</h2>
            <span>{posts.length} articles</span>
          </div>
        <ul class="post-list blog-post-grid">
          {posts.map((p) => (
            <li class="post-card">
              <a class="post-card-link" href={rel(`/blog/${p.slug}/`)}>
                <time datetime={p.data.publishDate.toISOString().slice(0, 10)}>
                  {formatDate(p.data.publishDate)}
                </time>
                <h2>{p.data.title}</h2>
                <p>{p.data.description}</p>
              </a>
              <div class="post-card-tags">
                {postTags(p).slice(0, 3).map((t) => (
                  <a class="tag" href={rel(`/blog/tags/${tagSlug(t)}/`)}>{tagLabel(t)}</a>
                ))}
              </div>
            </li>
          ))}
        </ul>
        </section>
      )}
    </div>
  </main>
</Base>
