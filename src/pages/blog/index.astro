---
import Base from '../../layouts/Base.astro';
import AnswerCard from '../../components/AnswerCard.astro';
import { STUDIO, ORIGIN, rel, abs } from '../../consts';
import { getPublishedPosts, getFeaturedPost, formatDate, POSTS_PER_PAGE } from '../../lib/blog';
import { eligibleTopicHubs } from '../../lib/topics';

const allPosts = await getPublishedPosts();
const topicHubs = eligibleTopicHubs(allPosts);
const featuredPost = allPosts.length > 0 ? getFeaturedPost(allPosts) : undefined;
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const pagePosts = allPosts.slice(0, POSTS_PER_PAGE).filter((post) => post.slug !== featuredPost?.slug);
const path = '/blog/';
const title = 'The Dudley Blog';
const description = 'Plain-English answers about iPhone privacy, AI media, internet culture, economics, and Dudley apps.';
const blogSchema = {
  '@context': 'https://schema.org', '@type': 'Blog', name: title, description, url: abs(path),
  publisher: { '@type': 'Organization', name: STUDIO, url: ORIGIN, logo: { '@type': 'ImageObject', url: abs('/assets/dudley-mark.svg') } },
  blogPost: allPosts.slice(0, POSTS_PER_PAGE).map((post) => ({
    '@type': 'BlogPosting', headline: post.data.title, description: post.data.description,
    url: abs(`/blog/${post.slug}/`), datePublished: post.data.publishDate.toISOString().slice(0, 10),
    author: { '@type': 'Person', name: post.data.author },
  })),
};
---
<Base title={title} description={description} path={path} schema={blogSchema}>
  <main class="page editorial-page">
    <div class="wrap blog-wrap">
      <header class="blog-hero">
        <p class="section-label">The Dudley Blog</p>
        <h1>Straight answers. Useful context.</h1>
        <p>{description}</p>
        <a class="feed-link" href={rel('/blog/rss.xml')}>RSS feed</a>
      </header>

      {topicHubs.length > 0 && (
        <nav class="browse" aria-label="Browse by topic">
          <p class="section-label">Browse by topic</p>
          <div class="browse-strip">
            {topicHubs.map((hub) => <a class="chip" href={rel(`/blog/topics/${hub.slug}/`)}>{hub.title} · {hub.posts.length}</a>)}
            <a class="chip" href={rel('/blog/topics/')}>All topics →</a>
          </div>
        </nav>
      )}

      {featuredPost && (
        <a class="featured" href={rel(`/blog/${featuredPost.slug}/`)}>
          <span class="section-label">{featuredPost.data.featured ? 'Featured answer' : 'Latest answer'}</span>
          <h2>{featuredPost.data.title}</h2>
          <p>{featuredPost.data.answerSummary ?? featuredPost.data.description}</p>
          <time datetime={featuredPost.data.publishDate.toISOString().slice(0, 10)}>{formatDate(featuredPost.data.publishDate)}</time>
        </a>
      )}

      <section class="answer-directory" aria-labelledby="recent-answers">
        <h2 id="recent-answers">Recent answers</h2>
        <div class="answer-grid">
          {pagePosts.map((post) => (
            <AnswerCard title={post.data.title} description={post.data.answerSummary ?? post.data.description} href={`/blog/${post.slug}/`} date={post.data.publishDate} topic={post.data.category} />
          ))}
        </div>
      </section>

      {totalPages > 1 && (
        <nav class="pagination" aria-label="Blog pages">
          <span aria-current="page">Page 1 of {totalPages}</span>
          <a class="btn" href={rel('/blog/2/')}>Next →</a>
        </nav>
      )}
    </div>
  </main>
</Base>
