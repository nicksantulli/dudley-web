---
import Base from '../../layouts/Base.astro';
import { STUDIO, ORIGIN, rel, abs } from '../../consts';
import {
  getPublishedPosts,
  getFeaturedPost,
  formatDate,
  POSTS_PER_PAGE,
} from '../../lib/blog';
import { eligibleTopicHubs, topicsForPost, unmappedLabelsForPost } from '../../lib/topics';

const allPosts = await getPublishedPosts();
const topicHubs = eligibleTopicHubs(allPosts);
const eligibleTopicSlugs = new Set(topicHubs.map((hub) => hub.slug));

const featuredPost = allPosts.length > 0 ? getFeaturedPost(allPosts) : undefined;

const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const pagePosts = allPosts.slice(0, POSTS_PER_PAGE).filter((p) => p.slug !== featuredPost?.slug);

const path = '/blog/';
const title = 'The Dudley Blog';
const description =
  'Plain-English answers about phones, privacy, AI, and internet culture — from Dudley Development, the studio behind Table Talk, VibeRater Social, and EconByte.';

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: title,
  description,
  url: abs(path),
  publisher: {
    '@type': 'Organization',
    name: STUDIO,
    url: ORIGIN,
    logo: { '@type': 'ImageObject', url: abs('/assets/dudley-mark.svg') },
  },
  blogPost: allPosts.slice(0, POSTS_PER_PAGE).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    description: p.data.description,
    url: abs(`/blog/${p.slug}/`),
    datePublished: p.data.publishDate.toISOString().slice(0, 10),
    author: { '@type': 'Organization', name: p.data.author },
  })),
};
---
<Base title={title} description={description} path={path} schema={blogSchema}>
  <main class="page">
    <div class="wrap blog-wrap">
      <header class="blog-hero">
        <h1>The Dudley Blog</h1>
        <p>{description}</p>
        <a class="feed-link" href={rel('/blog/rss.xml')}>RSS feed</a>
      </header>

      {topicHubs.length > 0 && (
        <nav class="browse" aria-label="Browse by topic">
          <span class="browse-label">Browse:</span>
          <div class="browse-strip">
            {topicHubs.map((hub) => (
              <a class="chip" href={rel(`/blog/topics/${hub.slug}/`)}>
                {hub.title} <span class="count">{hub.posts.length}</span>
              </a>
            ))}
            <a class="chip chip-all" href={rel('/blog/topics/')}>All topics →</a>
          </div>
        </nav>
      )}

      {allPosts.length === 0 ? (
        <p>No posts yet — check back soon.</p>
      ) : (
        <>
          {featuredPost && (
            <a class="featured" href={rel(`/blog/${featuredPost.slug}/`)}>
              <span class="featured-kicker">{featuredPost.data.featured ? 'Featured' : 'Latest'}</span>
              <h2>{featuredPost.data.title}</h2>
              <p>{featuredPost.data.description}</p>
              <time datetime={featuredPost.data.publishDate.toISOString().slice(0, 10)}>
                {formatDate(featuredPost.data.publishDate)}
              </time>
            </a>
          )}

          <ul class="post-grid">
            {pagePosts.map((p) => (
              <li class="post-card">
                <a class="post-card-link" href={rel(`/blog/${p.slug}/`)}>
                  <time datetime={p.data.publishDate.toISOString().slice(0, 10)}>
                    {formatDate(p.data.publishDate)}
                  </time>
                  <h3>{p.data.title}</h3>
                  <p>{p.data.description}</p>
                </a>
                <div class="post-card-tags">
                  {topicsForPost(p, eligibleTopicSlugs).slice(0, 2).map((topic) => (
                    <a class="chip chip-sm" href={rel(`/blog/topics/${topic.slug}/`)}>{topic.title}</a>
                  ))}
                  {unmappedLabelsForPost(p).slice(0, 1).map((label) => (
                    <span class="chip chip-sm tag-label">{label}</span>
                  ))}
                </div>
              </li>
            ))}
          </ul>

          {totalPages > 1 && (
            <nav class="pagination" aria-label="Blog pages">
              <span class="page-current" aria-current="page">Page 1 of {totalPages}</span>
              <a class="btn" href={rel('/blog/2/')}>Next →</a>
            </nav>
          )}
        </>
      )}
    </div>
  </main>
</Base>

<style>
  .blog-wrap { max-width: 880px; }

  .blog-hero { margin: 0 0 22px; }
  .blog-hero h1 { margin: 0 0 10px; }
  .blog-hero p { color: var(--fg-muted, var(--ink-muted, #7A4B33)); font-size: 17px; max-width: 640px; margin: 0 0 12px; }
  .feed-link {
    display: inline-block; font-size: 13px; font-weight: 600;
    color: var(--fg-muted, var(--ink-muted, #7A4B33));
    border: 1px solid var(--border, rgba(61, 28, 8, 0.12));
    border-radius: 999px; padding: 4px 12px;
  }
  .feed-link:hover { color: var(--fg, var(--ink, #2A1208)); text-decoration: none; }

  /* ---- Browse strip: the tag-cloud replacement ---- */
  .browse { margin: 0 0 30px; }
  .browse-label {
    display: block; font-size: 12px; font-weight: 800; letter-spacing: 0.6px; text-transform: uppercase;
    color: var(--fg-faint, var(--ink-faint, rgba(42, 18, 8, 0.38))); margin: 0 0 8px;
  }
  .browse-strip {
    display: flex; gap: 8px; flex-wrap: nowrap; overflow-x: auto;
    padding: 2px 2px 10px; margin: 0 -2px;
    scroll-snap-type: x proximity;
    scrollbar-width: none; -ms-overflow-style: none;
  }
  .browse-strip::-webkit-scrollbar { display: none; }
  .browse-strip .chip { flex: none; scroll-snap-align: start; }
  .chip-all {
    font-weight: 700;
    color: var(--accent, #9A3D04);
    border-color: var(--accent, #9A3D04);
  }

  .chip {
    display: inline-flex; align-items: center; gap: 6px; min-height: 36px; box-sizing: border-box;
    font-size: 13px; font-weight: 600; line-height: 1;
    color: var(--fg-muted, var(--ink-muted, #7A4B33));
    background: var(--card, var(--surface, #F8F2E4));
    border: 1px solid var(--border, rgba(61, 28, 8, 0.12));
    border-radius: 999px; padding: 8px 13px;
  }
  .chip:hover { color: var(--fg, var(--ink, #2A1208)); border-color: var(--accent, #9A3D04); text-decoration: none; }
  .chip .count { color: var(--fg-faint, var(--ink-faint, rgba(42, 18, 8, 0.38))); font-weight: 500; }

  .more-topics { margin-top: 4px; }
  .more-topics summary {
    cursor: pointer; list-style: none; font-size: 13px; font-weight: 700;
    color: var(--fg-muted, var(--ink-muted, #7A4B33)); padding: 6px 2px; width: fit-content;
  }
  .more-topics summary::-webkit-details-marker { display: none; }
  .more-topics summary::before { content: "▸ "; color: var(--accent, #9A3D04); }
  .more-topics[open] summary::before { content: "▾ "; }
  .more-topics-list { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 10px; }

  /* ---- Featured ---- */
  .featured {
    display: block; margin: 0 0 26px; padding: 26px 28px;
    background: var(--card, var(--surface, #F8F2E4));
    border: 1px solid var(--border, rgba(61, 28, 8, 0.12));
    border-left: 3px solid var(--accent, #9A3D04);
    border-radius: var(--radius, 16px); color: var(--fg, var(--ink, #2A1208));
  }
  .featured:hover { text-decoration: none; border-color: var(--accent, #9A3D04); }
  .featured-kicker {
    display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: 0.6px; text-transform: uppercase;
    color: var(--accent, #9A3D04); margin: 0 0 10px;
  }
  .featured h2 { margin: 0 0 8px; font-size: clamp(20px, 3vw, 26px); letter-spacing: -0.3px; }
  .featured p { margin: 0 0 12px; color: var(--fg-muted, var(--ink-muted, #7A4B33)); font-size: 15.5px; max-width: 60ch; }
  .featured time { color: var(--fg-faint, var(--ink-faint, rgba(42, 18, 8, 0.38))); font-size: 13px; }

  /* ---- Post grid ---- */
  .post-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 720px) {
    .post-grid { grid-template-columns: 1fr 1fr; }
  }
  .post-card {
    display: flex; flex-direction: column;
    background: var(--card, var(--surface, #F8F2E4));
    border: 1px solid var(--border, rgba(61, 28, 8, 0.12));
    border-radius: var(--radius, 16px); padding: 22px 24px;
  }
  .post-card:hover { border-color: var(--accent, #9A3D04); }
  .post-card-link { display: block; color: var(--fg, var(--ink, #2A1208)); flex: 1; }
  .post-card-link:hover { text-decoration: none; }
  .post-card-link time { color: var(--fg-faint, var(--ink-faint, rgba(42, 18, 8, 0.38))); font-size: 13px; }
  .post-card-link h3 { font-size: 19px; font-weight: 800; letter-spacing: -0.3px; margin: 6px 0 8px; color: var(--fg, var(--ink, #2A1208)); }
  .post-card-link p {
    color: var(--fg-muted, var(--ink-muted, #7A4B33)); font-size: 14.5px; margin: 0;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .post-card-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .chip-sm { min-height: 32px; font-size: 12px; padding: 6px 11px; }

  /* ---- Pagination ---- */
  .pagination {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    margin-top: 34px; padding-top: 22px; border-top: 1px solid var(--border, rgba(61, 28, 8, 0.12));
  }
  .page-current { font-size: 13px; color: var(--fg-faint, var(--ink-faint, rgba(42, 18, 8, 0.38))); }
</style>
