---
import Base from '../../../layouts/Base.astro';
import { rel } from '../../../consts';
import { getPublishedPosts, getAllTags, postTags, tagSlug, tagLabel, formatDate } from '../../../lib/blog';
import { TOPIC_HUBS, eligibleTopicHubs, topicForLabel, topicsForPost, unmappedLabelsForPost } from '../../../lib/topics';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const eligibleTopicSlugs = eligibleTopicHubs(posts).map((hub) => hub.slug);
  const tags = await getAllTags(); // already merged/deduped by slug — one static path per topic
  return tags.map(({ tag, slug }) => ({
    params: { tag: slug },
    props: {
      tag,
      posts: posts.filter((p) => postTags(p).some((t) => tagSlug(t) === slug)),
      eligibleTopicSlugs,
    },
  }));
}

const { tag, posts, eligibleTopicSlugs } = Astro.props;
const eligibleTopics = new Set(eligibleTopicSlugs);
const label = tagLabel(tag);
const path = `/blog/tags/${tagSlug(tag)}/`;
const title = `${label} — The Dudley Blog`;
const description = `Every Dudley Development post tagged ${label}. ${posts.length} ${posts.length === 1 ? 'post' : 'posts'}.`;
const mappedTopicCandidate = topicForLabel(tag);
const mappedTopic = mappedTopicCandidate && eligibleTopics.has(mappedTopicCandidate) ? mappedTopicCandidate : undefined;
const mappedMeta = mappedTopic ? TOPIC_HUBS[mappedTopic] : null;
---
<Base title={title} description={description} path={path} robots="noindex,follow" breadcrumbLeaf={label}>
  <main class="page">
    <div class="wrap tag-wrap">
      <nav class="crumbs">
        <a href={rel('/')}>Home</a><span class="sep">/</span>
        <a href={rel('/blog/')}>Blog</a><span class="sep">/</span>
        <a href={rel('/blog/topics/')}>Topics</a><span class="sep">/</span>
        <span>{label}</span>
      </nav>
      <header class="tag-hero">
        <h1>{label}</h1>
        <p>This legacy label is kept for old links. Browse the {posts.length} {posts.length === 1 ? 'post' : 'posts'} below.</p>
        {mappedTopic && mappedMeta ? (
          <a class="all-topics" href={rel(`/blog/topics/${mappedTopic}/`)}>Go to {mappedMeta.title} →</a>
        ) : (
          <a class="all-topics" href={rel('/blog/')}>← Back to the blog</a>
        )}
      </header>

      <ul class="post-grid">
        {posts.map((p) => (
          <li class="post-card">
            <a class="post-card-link" href={rel(`/blog/${p.slug}/`)}>
              <time datetime={p.data.publishDate.toISOString().slice(0, 10)}>
                {formatDate(p.data.publishDate)}
              </time>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
            </a>
            <div class="post-card-tags">
              {topicsForPost(p, eligibleTopics).slice(0, 2).map((topic) => (
                <a class="chip" href={rel(`/blog/topics/${topic.slug}/`)}>{topic.title}</a>
              ))}
              {unmappedLabelsForPost(p).slice(0, 1).map((text) => <span class="chip tag-label">{text}</span>)}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </main>
</Base>

<style>
  .tag-wrap { max-width: 880px; }
  .crumbs { font-size: 13px; color: var(--fg-faint, var(--ink-faint, rgba(42, 18, 8, 0.38))); margin: 0 0 18px; display: flex; gap: 8px; flex-wrap: wrap; }
  .crumbs a { color: var(--fg-muted, var(--ink-muted, #7A4B33)); }
  .crumbs .sep { color: var(--fg-faint, var(--ink-faint, rgba(42, 18, 8, 0.38))); }

  .tag-hero { margin: 0 0 26px; }
  .tag-hero h1 { margin: 0 0 10px; }
  .tag-hero p { color: var(--fg-muted, var(--ink-muted, #7A4B33)); font-size: 16px; margin: 0 0 12px; }
  .all-topics { font-size: 13px; font-weight: 600; color: var(--fg-muted, var(--ink-muted, #7A4B33)); }
  .all-topics:hover { color: var(--fg, var(--ink, #2A1208)); }

  .post-grid { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 720px) {
    .post-grid { grid-template-columns: 1fr 1fr; }
  }
  .post-card {
    display: flex; flex-direction: column;
    background: var(--card, var(--surface, #F8F2E4));
    border: 1px solid var(--border, rgba(61, 28, 8, 0.12));
    border-radius: var(--radius, 16px); padding: 22px 24px;
  }
  .post-card:hover { border-color: var(--accent, #9A3D04); }
  .post-card-link { display: block; color: var(--fg, var(--ink, #2A1208)); flex: 1; }
  .post-card-link:hover { text-decoration: none; }
  .post-card-link time { color: var(--fg-faint, var(--ink-faint, rgba(42, 18, 8, 0.38))); font-size: 13px; }
  .post-card-link h2 { font-size: 19px; font-weight: 800; letter-spacing: -0.3px; margin: 6px 0 8px; color: var(--fg, var(--ink, #2A1208)); }
  .post-card-link p {
    color: var(--fg-muted, var(--ink-muted, #7A4B33)); font-size: 14.5px; margin: 0;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .post-card-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .chip {
    display: inline-flex; align-items: center; gap: 6px; min-height: 32px; box-sizing: border-box;
    font-size: 12px; font-weight: 600; line-height: 1;
    color: var(--fg-muted, var(--ink-muted, #7A4B33));
    background: var(--card, var(--surface, #F8F2E4));
    border: 1px solid var(--border, rgba(61, 28, 8, 0.12));
    border-radius: 999px; padding: 6px 11px;
  }
  .chip:hover { color: var(--fg, var(--ink, #2A1208)); border-color: var(--accent, #9A3D04); text-decoration: none; }
</style>
