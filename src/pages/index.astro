---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AppPosterBand from '../components/AppPosterBand.astro';
import AnswerCard from '../components/AnswerCard.astro';
import { ORIGIN, SUPPORT_EMAIL, abs, rel } from '../consts';
import { appStoreCampaignUrl, HOME_APP_STORE_TOKENS } from '../lib/campaignLinks.mjs';
import { getPublishedPosts } from '../lib/blog';

const allApps = await getCollection('apps');
const order = ['last-human', 'table-talk', 'vibe-rater', 'econbyte', 'monetary-policy-independence-day'];
const rank = new Map(order.map((slug, index) => [slug, index]));
const ownedLive = allApps
  .filter((app) => !app.data.developedFor && app.data.status === 'live')
  .sort((a, b) => (rank.get(a.id) ?? 99) - (rank.get(b.id) ?? 99));
const upcoming = allApps
  .filter((app) => !app.data.developedFor && app.data.status !== 'live')
  .sort((a, b) => a.data.order - b.data.order);
const clientApps = allApps
  .filter((app) => app.data.developedFor)
  .sort((a, b) => a.data.order - b.data.order);

const storeUrlFor = (app: any): string => {
  const id = app.data.appStoreId as string;
  if (!id) return '';
  const token = HOME_APP_STORE_TOKENS[id];
  if (!token) throw new Error(`Missing homepage campaign token for ${app.data.name} (${id})`);
  return appStoreCampaignUrl(id, token);
};

const posts = (await getPublishedPosts()).slice(0, 4);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': abs('/#website'),
  name: 'Dudley Development',
  url: ORIGIN,
  publisher: { '@id': abs('/#organization') },
};
const description = 'Arcade satire, dinner-table cards, and plain-language tools. No signup as a cover charge.';
---
<Base title="Dudley Development — apps that earn the tap" description={description} path="/" schema={schema}>
  <main>
    <section class="home-intro">
      <div class="wrap home-intro-inner">
        <h1>Apps that work before they ask who you are.</h1>
        <p>Arcade satire, dinner-table cards, and plain-language tools. No signup as a cover charge.</p>
      </div>
    </section>

    <div id="apps" class="poster-wall">
      {ownedLive.map((app, index) => (
        <AppPosterBand
          slug={app.id}
          name={app.data.name}
          headline={app.data.posterHeadline}
          description={app.data.description}
          icon={app.data.icon}
          facts={app.data.posterFacts}
          status={app.data.status}
          storeHref={storeUrlFor(app)}
          detailHref={`/apps/${app.id}/`}
          art={app.data.ogImage}
          reverse={index % 2 === 1}
        />
      ))}
    </div>

    {posts.length > 0 && (
      <section class="answers-band connectors-band" aria-labelledby="connectors">
        <div class="wrap">
          <div class="editorial-head">
            <div>
              <p class="section-label">For businesses</p>
              <h2 id="connectors">Connectors for your AI assistant</h2>
            </div>
            <a href={rel('/connectors/catalog-prep/')}>See Catalog Prep</a>
          </div>
          <div class="answer-grid">
            <article class="answer-card">
              <a href={rel('/connectors/catalog-prep/')}>
                <div class="answer-meta"><span>MCP connector</span><span>Free prototype</span></div>
                <h3>Catalog Prep</h3>
                <p>Turn messy corrugated box supplier files into a clean import file for your store, plus a list of every field it could not fill. Works in Claude and ChatGPT.</p>
                <span class="answer-link">How it works</span>
              </a>
            </article>
          </div>
        </div>
      </section>
      <section class="answers-band" aria-labelledby="latest-answers">
        <div class="wrap">
          <div class="editorial-head">
            <div>
              <p class="section-label">The Dudley Blog</p>
              <h2 id="latest-answers">Notes from the shop</h2>
            </div>
            <a href={rel('/blog/')}>Read every answer</a>
          </div>
          <div class="answer-grid">
            {posts.map((post) => (
              <AnswerCard
                title={post.data.title}
                description={post.data.answerSummary ?? post.data.description}
                href={`/blog/${post.id}/`}
                date={post.data.publishDate}
                topic={post.data.category}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    {upcoming.length > 0 && (
      <section class="catalog-heading" aria-labelledby="next-from-dudley">
        <div class="wrap">
          <h2 id="next-from-dudley">On deck</h2>
          <p>Already on the App Store: <a href={rel('/apps/last-human/')}>Last Human</a>, <a href={rel('/apps/table-talk/')}>Table Talk</a>, and <a href={rel('/apps/econbyte/')}>EconByte</a>.</p>
        </div>
      </section>
    )}
    {upcoming.map((app, index) => (
      <AppPosterBand
        slug={app.id}
        name={app.data.name}
        headline={app.data.posterHeadline}
        description={app.data.description}
        icon={app.data.icon}
        facts={app.data.posterFacts}
        status={app.data.status}
        detailHref={app.data.landingPage === false ? undefined : `/apps/${app.id}/`}
        art={app.data.ogImage}
        reverse={index % 2 === 0}
      />
    ))}

    {clientApps.length > 0 && (
      <section class="catalog-heading client-heading" aria-labelledby="built-for-others">
        <div class="wrap">
          <p class="section-label">Client work</p>
          <h2 id="built-for-others">Built for others</h2>
          <p>Products designed and built for partners under their brand.</p>
        </div>
      </section>
    )}
    {clientApps.map((app, index) => (
      <AppPosterBand
        slug={app.id}
        name={app.data.name}
        headline={app.data.posterHeadline}
        description={app.data.description}
        icon={app.data.icon}
        facts={app.data.posterFacts}
        status={app.data.status}
        storeHref={storeUrlFor(app)}
        detailHref={app.data.landingPage === false ? undefined : `/apps/${app.id}/`}
        developedFor={app.data.developedFor}
        art={app.data.ogImage}
        reverse={index % 2 === 1}
      />
    ))}

    <section class="home-help" aria-labelledby="need-a-hand">
      <div class="wrap home-help-inner">
        <div>
          <p class="section-label">Support</p>
          <h2 id="need-a-hand">Need a hand, or have an app in mind?</h2>
        </div>
        <div class="home-help-actions">
          <a href={rel('/support/')}>Get app support</a>
          <a href={rel('/contact/')}>Start a conversation</a>
          <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
        </div>
      </div>
    </section>
  </main>
</Base>
