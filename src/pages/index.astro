---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { rel, ORIGIN, APP_STORE, appStoreUrl, SUPPORT_EMAIL } from '../consts';
import { appStoreCampaignUrl, VIBERATER_ASC_TOKENS } from '../lib/campaignLinks.mjs';
import { getPublishedPosts, formatDate } from '../lib/blog';

const allApps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
// Studio's own apps vs. client work (apps built for a partner — see `developedFor`).
const apps = allApps.filter((a) => !a.data.developedFor);
const clientApps = allApps.filter((a) => a.data.developedFor);

// A card's App Store link: VibeRater gets an Apple Ads campaign token so home-page
// installs are attributable; everything else uses the plain store URL.
const storeUrlFor = (app: any) =>
  app.data.appStoreId === APP_STORE.vibeRater
    ? appStoreCampaignUrl(app.data.appStoreId, VIBERATER_ASC_TOKENS.home)
    : appStoreUrl(app.data.appStoreId);

const liveCount = allApps.filter((a) => a.data.status === 'live' && !!a.data.appStoreId).length;

const posts = (await getPublishedPosts()).slice(0, 3);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Dudley Development',
  url: ORIGIN,
};
const description =
  'Dudley Development is a small independent studio building polished, playful iPhone apps. Maker of VibeRater Social, Table Talk, EconByte and more — free to play, privacy-first.';

const values = [
  {
    icon: '🎁',
    title: 'Free to start',
    body: 'Every app is free to download and play. No paywall standing between you and the fun.',
  },
  {
    icon: '🔒',
    title: 'Privacy-first',
    body: 'Each policy spells out what stays on your device, what reaches a service, and why. No cross-app tracking prompts.',
  },
  {
    icon: '📣',
    title: 'Honest about ads',
    body: 'Our free apps are ad-supported through AdMob, requested as non-personalized, and disclosed plainly.',
  },
  {
    icon: '✨',
    title: 'Polish is the point',
    body: 'Tight controls, real haptics, and a sense of humor — details that make an app feel made, not generated.',
  },
];
---
<Base title="Dudley Development — iOS apps with character" description={description} path="/" schema={schema}>
  <main>
    <!-- ---------- Hero ---------- -->
    <section class="hero">
      <div class="wrap">
        <div class="hero-inner">
          <span class="eyebrow">Independent iOS studio</span>
          <h1>Small apps with<br /><span class="grad">real character.</span></h1>
          <p class="lede">
            We build polished, playful iPhone apps — the kind you actually want to open.
            Free to play, privacy-first, and made with care.
          </p>
          <div class="actions">
            <a class="btn primary" href="#apps">See the apps</a>
            <a class="btn secondary" href={rel('/contact/')}>Get in touch</a>
          </div>
          <ul class="hero-facts">
            <li>{liveCount} apps live on the App Store</li>
            <li>Free to download</li>
            <li>No cross-app tracking</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ---------- The apps ---------- -->
    <section id="apps">
      <div class="wrap">
        <div class="section-head split">
          <div class="section-head-text">
            <h2>The apps</h2>
            <p class="sub">Free on the App Store. Clear privacy choices. No nonsense.</p>
          </div>
          <a class="btn ghost small" href={rel('/about')}>About the studio</a>
        </div>

        <ul class="apps">
          {apps.map((app) => {
            const url = storeUrlFor(app);
            const live = app.data.status === 'live' && !!url;
            const hasPage = app.data.landingPage !== false;
            return (
              <li class="app-card">
                <div class="top">
                  <img
                    class="icon"
                    src={rel(app.data.icon)}
                    alt={`${app.data.name} app icon`}
                    width="60" height="60" loading="lazy" decoding="async"
                  />
                  <div>
                    <h3>{app.data.name}</h3>
                    <p class="tagline">{app.data.tagline}</p>
                  </div>
                </div>
                <div class="card-meta">
                  <span class={`badge ${live ? 'live' : 'soon'}`}>
                    <span class="dot"></span> {live ? 'Live' : 'Coming soon'}
                  </span>
                  <span class="partner-tag">{app.data.category}</span>
                </div>
                <p class="desc">{app.data.description}</p>
                <div class="actions">
                  {live && (
                    <a
                      class="btn app-store-badge compact"
                      href={url}
                      rel="noopener"
                      aria-label={`Download ${app.data.name} on the App Store`}
                    >
                      <span class="top">Download on the</span>
                      <span class="bottom">App Store</span>
                    </a>
                  )}
                  {hasPage && (
                    <a class={`btn${live ? '' : ' primary'}`} href={rel(`/apps/${app.slug}/`)}>
                      Learn more<span class="sr-only"> about {app.data.name}</span>
                    </a>
                  )}
                  {!live && !hasPage && <span class="btn disabled" aria-disabled="true">Coming soon</span>}
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <!-- ---------- Client work ---------- -->
    {clientApps.length > 0 && (
      <section id="client-work" class="alt-band">
        <div class="wrap">
          <div class="section-head">
            <h2>Client work</h2>
            <p class="sub">Apps we design and build for partners, under their brand.</p>
          </div>

          <ul class="apps">
            {clientApps.map((app) => {
              const url = storeUrlFor(app);
              const live = app.data.status === 'live' && !!url;
              const hasPage = app.data.landingPage !== false;
              return (
                <li class="app-card">
                  <div class="top">
                    <img
                      class="icon"
                      src={rel(app.data.icon)}
                      alt={`${app.data.name} app icon`}
                      width="60" height="60" loading="lazy" decoding="async"
                    />
                    <div>
                      <h3>{app.data.name}</h3>
                      <p class="tagline">{app.data.tagline}</p>
                    </div>
                  </div>
                  <div class="card-meta">
                    <span class={`badge ${live ? 'live' : 'soon'}`}>
                      <span class="dot"></span> {live ? 'Live' : 'Coming soon'}
                    </span>
                    <span class="partner-tag">Created for {app.data.developedFor}</span>
                  </div>
                  <p class="desc">{app.data.description}</p>
                  <div class="actions">
                    {live && (
                      <a
                        class="btn app-store-badge compact"
                        href={url}
                        rel="noopener"
                        aria-label={`Download ${app.data.name} on the App Store`}
                      >
                        <span class="top">Download on the</span>
                        <span class="bottom">App Store</span>
                      </a>
                    )}
                    {hasPage && (
                      <a class={`btn${live ? '' : ' primary'}`} href={rel(`/apps/${app.slug}/`)}>
                        Learn more<span class="sr-only"> about {app.data.name}</span>
                      </a>
                    )}
                    {!live && !hasPage && <span class="btn disabled" aria-disabled="true">Coming soon</span>}
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      </section>
    )}

    <!-- ---------- Latest from the blog ---------- -->
    {posts.length > 0 && (
      <section id="blog">
        <div class="wrap">
          <div class="section-head split">
            <div class="section-head-text">
              <h2>Latest from the blog</h2>
              <p class="sub">Plain-English answers about phones, photos, privacy, and the internet's weirder corners.</p>
            </div>
            <a class="btn ghost small" href={rel('/blog/')}>All posts</a>
          </div>

          <ul class="post-list cols-3">
            {posts.map((post) => (
              <li class="post-card">
                <a class="post-card-link" href={rel(`/blog/${post.slug}/`)}>
                  <time datetime={post.data.publishDate.toISOString().slice(0, 10)}>
                    {formatDate(post.data.publishDate)}
                  </time>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- ---------- Why Dudley ---------- -->
    <section id="why-dudley" class="alt-band">
      <div class="wrap">
        <div class="section-head">
          <h2>Why Dudley</h2>
          <p class="sub">Built honestly, shipped carefully — the same four rules on every app.</p>
        </div>

        <ul class="feature-grid cols-4">
          {values.map((v) => (
            <li class="feature">
              <span class="feature-icon" aria-hidden="true">{v.icon}</span>
              <h3>{v.title}</h3>
              <p>{v.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ---------- Contact ---------- -->
    <section id="contact">
      <div class="wrap">
        <div class="cta-block">
          <h2>Questions, bugs, or an idea?</h2>
          <p>
            Send us a note and it lands in the studio inbox — usually answered within a couple of days.
            Already using one of our apps? Support has the quick answers.
          </p>
          <div class="actions">
            <a class="btn primary" href={rel('/contact/')}>Get in touch</a>
            <a class="btn" href={rel('/support')}>Visit support</a>
            <a class="btn ghost" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>
